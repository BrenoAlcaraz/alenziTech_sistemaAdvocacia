# ─── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=troque-esta-chave-por-uma-string-aleatoria-longa
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost
# Escritórios ficam em <slug>.<DOMINIO_BASE> (produção: domínio da plataforma)
DOMINIO_BASE=localhost

# ─── Banco de Dados (PostgreSQL obrigatório para django-tenants) ───────────────
DB_NAME=juridico_db
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui
DB_HOST=localhost
DB_PORT=5432

# ─── Mídia e Static ────────────────────────────────────────────────────────────
MEDIA_URL=/media/
STATIC_URL=/static/

# ─── Acompanhamento de processos (DataJud + DJEN) ──────────────────────────────
# Chave pública da API do DataJud, publicada na wiki do CNJ
# (datajud-wiki.cnj.jus.br/api-publica/acesso); trocar aqui se o CNJ mudar.
DATAJUD_API_KEY=
# Dias não úteis do cálculo de prazo: feriados fixos (DD/MM), datas avulsas
# (AAAA-MM-DD) e recesso forense (DD/MM-DD/MM). Sexta-feira Santa é automática.
FERIADOS_NACIONAIS=01/01,21/04,01/05,07/09,12/10,02/11,15/11,20/11,25/12
FERIADOS_AVULSOS=
RECESSO_FORENSE=20/12-20/01
